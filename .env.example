# Copy this file to .env for local development. .env is not committed.

# Your locally installed PostgreSQL. Replace YOUR_PASSWORD with the password of
# the postgres user (set when PostgreSQL was installed), and create the
# order_tagger database before running `npx prisma migrate dev`.
# In production, set DATABASE_URL to the host's managed database instead.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/order_tagger"
