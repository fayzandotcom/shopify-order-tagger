// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A tagging rule: when an order matches the condition (field, operator, value),
// the tag is added to it. Allowed fields and operators are in app/rules.ts.
model Rule {
  id        Int      @id @default(autoincrement())
  shop      String
  field     String
  operator  String
  value     String
  tag       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

// An order the app tagged, for the activity list. No customer details.
// tags and matchedRules are JSON arrays: tags as strings, matchedRules as
// { id, condition, tag } snapshots so they survive the rule being edited or deleted.
model TaggedOrder {
  id           Int      @id @default(autoincrement())
  shop         String
  orderId      String
  orderName    String
  tags         String
  matchedRules String
  createdAt    DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, createdAt])
}
